{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<cfg>/dotclaude/guard.js\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<cfg>/dotclaude/report-check.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"<cfg>/dotclaude/statusline.js\""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(node --test:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ls:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr diff:*)",
      "PowerShell(gh pr checks:*)",
      "PowerShell(gh pr list:*)",
      "PowerShell(gh issue view:*)",
      "PowerShell(gh issue list:*)",
      "PowerShell(gh repo view:*)",
      "PowerShell(node --test:*)",
      "PowerShell(npm test:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(pytest:*)",
      "PowerShell(python -m pytest:*)",
      "PowerShell(ls:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "PowerShell(git push --force origin main:*)",
      "PowerShell(git push -f origin main:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
