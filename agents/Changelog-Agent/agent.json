{
  "name": "changelog-agent",
  "version": "1.0.0",
  "description": "Generates and maintains CHANGELOG.md files from git history",
  "scope": "documentation",
  "author": "Agent Infrastructure Team",
  "created": "2026-01-17",
  "updated": "2026-01-17",
  "mcp_servers": [
    "filesystem",
    "git"
  ],
  "dependencies": [],
  "input_types": [
    "git repository",
    "git commit history",
    "version tags",
    "existing CHANGELOG.md"
  ],
  "output_types": [
    "CHANGELOG.md file",
    "version summaries"
  ],
  "constraints": [
    "Only creates CHANGELOG.md files",
    "Requires git repository",
    "Does not modify source code",
    "Does not create git tags or releases",
    "Follows Keep a Changelog format"
  ]
}