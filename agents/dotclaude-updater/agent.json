{
  "name": "dotclaude-updater",
  "version": "1.0.0",
  "description": "Updates and verifies dotClaude installation from GitHub",
  "scope": "infrastructure",
  "author": "Agent Infrastructure Team",
  "created": "2026-01-18",
  "updated": "2026-01-18",
  "mcp_servers": [
    "git",
    "filesystem"
  ],
  "dependencies": [],
  "input_types": [
    "dotClaude repository path",
    "git remote URL"
  ],
  "output_types": [
    "update status",
    "list of changes",
    "new/updated agents list",
    "verification report"
  ],
  "constraints": [
    "Only pulls from remote, never pushes",
    "Does not modify local customizations",
    "Does not auto-run install scripts",
    "Requires git repository",
    "Read-only operations on remote"
  ]
}
