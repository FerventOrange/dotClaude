{
  "name": "readme-agent",
  "version": "1.0.0",
  "description": "Generates comprehensive README.md files for projects",
  "scope": "documentation",
  "author": "Agent Infrastructure Team",
  "created": "2026-01-17",
  "updated": "2026-01-17",
  "mcp_servers": [
    "filesystem"
  ],
  "dependencies": [],
  "input_types": [
    "project directory",
    "source code files",
    "package.json/requirements.txt/go.mod",
    "existing documentation"
  ],
  "output_types": [
    "README.md file"
  ],
  "constraints": [
    "Only creates README.md files",
    "Does not modify other documentation",
    "Does not write code or tests",
    "Focuses on project-level documentation only"
  ]
}